# Server-only secrets. Never prefix these with NEXT_PUBLIC_. Leave blank for mock mode.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Public by design: the anon key is protected by RLS + disabled signups.
NEXT_PUBLIC_SUPABASE_URL=
# The public key. Any ONE of these names works: ..._ANON_KEY, ..._PUBLISHABLE_KEY, or
# ..._PUBLISHABLE_DEFAULT_KEY (what Supabase's Vercel integration sets). Never the service-role/secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
